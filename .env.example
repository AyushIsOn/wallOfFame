# Copy to .env for local development: `cp .env.example .env`.
# The server loads .env on startup (server/env.js); real environment variables
# always win. Vite also reads the VITE_* values from this file at build time.
# Full reference: docs/configuration.md

# Port the server listens on (Render sets this automatically).
PORT=3000

# Admin login password. Locally it defaults to "admin" if unset; in production
# (DATABASE_URL set) admin login stays DISABLED until you set it.
ADMIN_PASSWORD=change-me

# Secret that signs admin session tokens. Use a long random string in production
# (Render generates one). If unset in production, a random per-process secret
# is used and admins are logged out on every restart.
TOKEN_SECRET=replace-with-a-long-random-string

# Leave DATABASE_URL EMPTY locally -> the server uses in-process PGlite
# (no database server needed). On Render, paste the Postgres Internal URL.
DATABASE_URL=
# Set to false only if your Postgres rejects SSL connections.
# PGSSL=false
# Local PGlite data directory (only used when DATABASE_URL is empty).
PGLITE_DIR=./.data/pg

# Seed the 25 sample students into an EMPTY database on first boot.
# Set to false for a real deployment that should start empty.
SEED_SAMPLE_DATA=true

# Optional: n8n webhook that takes { about } and returns { bio, tags }.
# If unset or failing, a built-in fallback trims the bio and picks tags.
N8N_TAGS_WEBHOOK_URL=

# Reverse-proxy hops in front of the server (for the login rate limit's client
# IP). Defaults to 1 on Render, 0 elsewhere. Only change if you add a proxy.
# TRUST_PROXY=1

# Optional (build time): link for the header's "GET FEATURED" text, e.g. the
# Google/Microsoft Form students use to submit achievements.
VITE_GET_FEATURED_URL=
